# PostgreSQL password for the dashboard database
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-in-production

# Full PostgreSQL connection string (constructed from above — matches compose service name)
# In docker-compose, the app/worker use this value directly
# For local dev outside Docker: postgresql://dashboard:dashboard@localhost:5432/dashboard
DATABASE_URL=postgresql://dashboard:${POSTGRES_PASSWORD}@postgres:5432/dashboard

# Redis connection string (matches compose service name)
# For local dev outside Docker: redis://localhost:6379
REDIS_URL=redis://redis:6379

# 32-byte hex key for encrypting Proxmox node SSH passwords at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Secret for iron-session cookie signing (any long random string)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# WalletConnect project ID for RainbowKit Universal Profile connector
# Obtain from: https://cloud.walletconnect.com
# Leave empty to use fallback (disables WalletConnect relay, UP wallet still works locally)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# External port for the Next.js app container (default: 3000)
PORT=3000
