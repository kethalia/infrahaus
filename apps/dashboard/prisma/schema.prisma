// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ==================== Enums ====================

enum PackageManager {
  apt
  npm
  pip
  custom
}

enum TemplateSource {
  filesystem
  custom
}

enum FilePolicy {
  replace
  default
  backup
}

// ==================== Models ====================

model ProxmoxNode {
  id          String   @id @default(cuid())
  name        String
  host        String
  port        Int      @default(8006)
  tokenId     String?  // API token — optional, only needed for worker (background jobs)
  tokenSecret String?  // Encrypted via encryption utility — optional, paired with tokenId
  sshPassword String?  // Encrypted — for SSH to Proxmox host for pct exec
  fingerprint String?
  isDefault   Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Template {
  id           String         @id @default(cuid())
  name         String         @unique
  description  String?
  source       TemplateSource @default(filesystem)
  path         String? // Filesystem path for filesystem templates
  osTemplate   String? // e.g., "debian-12-standard"
  cores        Int?
  memory       Int? // MB
  swap         Int? // MB
  diskSize     Int? // GB
  storage      String? // e.g., "local-lvm"
  bridge       String? // e.g., "vmbr0"
  unprivileged Boolean        @default(true)
  nesting      Boolean        @default(false)
  keyctl       Boolean        @default(false)
  fuse         Boolean        @default(false)
  tags         String? // Comma-separated or JSON array
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  scripts    TemplateScript[]
  files      TemplateFile[]
  packages   Package[]
}

model PackageBucket {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  packages Package[]
}

model Package {
  id       String         @id @default(cuid())
  name     String
  manager  PackageManager
  version  String?
  bucketId String?
  bucket   PackageBucket? @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([bucketId])
  @@index([templateId])
}

model TemplateScript {
  id          String   @id @default(cuid())
  name        String
  order       Int // Execution order
  content     String   @db.Text
  description String?
  enabled     Boolean  @default(true)
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TemplateFile {
  id         String     @id @default(cuid())
  name       String
  targetPath String // Path where file will be deployed
  policy     FilePolicy @default(replace)
  content    String     @db.Text
  templateId String
  template   Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// Per-container credentials stored in PostgreSQL for durability.
/// Keyed by compound containerId ({nodeName}/{vmid}) — same format used
/// across Redis keys, URLs, and internal identifiers.
///
/// Stores:
///   - SSH key pair for direct SSH access to the container
///   - Root password generated during container creation
///
/// Created by createContainerAction, deleted by deleteContainerAction.
model ContainerCredential {
  id            String   @id @default(cuid())
  containerId   String   @unique // compound: "nodeName/vmid" — matches toContainerId() format
  userId        String
  sshPrivateKey String   @db.Text // Encrypted via lib/encryption.ts — OpenSSH format (multi-line)
  sshPublicKey  String   // Plain text — "ssh-ed25519 AAAA..." for display + Proxmox injection
  rootPassword  String   // Encrypted via lib/encryption.ts — random password set during creation
  createdAt     DateTime @default(now())

  @@index([userId])
}


