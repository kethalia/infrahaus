# Database
DATABASE_URL="postgresql://dashboard:dashboard@localhost:5432/dashboard"

# Redis
REDIS_URL="redis://localhost:6379"

# Encryption
# Generate a new key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="REPLACE_WITH_YOUR_64_CHARACTER_HEX_KEY"

# Session
# Generate a new secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_YOUR_32_PLUS_CHARACTER_SECRET"

# Web3 / Wallet Authentication
# Get a free project ID at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3001"
